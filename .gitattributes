# Normalize text files to LF in the repository and working tree so scripts
# behave the same on Windows, Linux, and CI.
* text=auto eol=lf

# Preserve trailing whitespace in the two pinned upstream QR sources.
# Other whitespace checks and application-owned files retain their policy.
firmware/common/lib/qrcodegen/qrcodegen.c whitespace=-blank-at-eol
firmware/common/lib/qrcodegen/qrcodegen.h whitespace=-blank-at-eol

*.png binary
*.jpg binary
*.webp binary
*.pdf binary
*.zip binary
*.sr binary
*.step -diff
*.stp -diff
*.wrl -diff
