 *
 * Smart LED Badge Rev A, application core: Raytac MDBT53-P1M (nRF5340 QKAA).
 * Pins follow the Rev A schematic; see docs/hardware.md. Modified from
 * Zephyr's raytac_mdbt53_db_40 board for this board.
 */

/dts-v1/;
#include <nordic/nrf5340_cpuapp_qkaa.dtsi>
#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/sensor/icm42688.h>
#include "smart_led_badge_nrf5340_cpuapp-pinctrl.dtsi"

/ {
	model = "Smart LED Badge Rev A nRF5340 Application";
	compatible = "smart-led-badge,rev-a-nrf5340-cpuapp";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,bt-hci = &bt_hci_ipc0;
		zephyr,sram = &sram0_image;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,sram-secure-partition = &sram0_s;
		zephyr,sram-non-secure-partition = &sram0_ns;
	};

	leds {
		compatible = "gpio-leds";

		status_led: led_0 {
			gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
			label = "Status LED (D1201)";
		};
	};

	buttons {
		compatible = "gpio-keys";

		btn_mode: button_0 {
			gpios = <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Mode/Next (SW1201)";
			zephyr,code = <INPUT_KEY_0>;
		};

		btn_action: button_1 {
			gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Action/Select (SW1202)";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	/*
	 * Board signals used by project drivers. Defaults with the MCU in reset
	 * come from board resistors: MTX_BLANK high, MTX_ARM low, LED_EN low,
	 * VBAT_MEAS_EN low, CHG_CE high (charging off).
	 */
	zephyr,user {
		mtx-lat-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		mtx-blank-gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;  /* high = columns blanked */
		mtx-arm-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;    /* low clears the scan-stall one-shot */
		mtx-safe-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;   /* input: high = matrix forced off */
		led-en-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;     /* TPS61023 EN (LED rail) */
		vbat-meas-en-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
		chg-ce-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;      /* active = charging enabled */
		chg-int-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
		chg-stat-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
		pwr-sw-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* active = switch ON */
		nfc-pwr-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | NRF_GPIO_DRIVE_H0H1)>;
		nfc-fd-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
		imu-int2-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;

		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
		io-channel-names = "vbat", "cc1", "cc2", "vled";
	};

	aliases {
		led0 = &status_led;
		sw0 = &btn_mode;
		sw1 = &btn_action;
		watchdog0 = &wdt0;
		imu0 = &imu;
	};
};

&vregmain {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregradio {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

/* VDDH = VDD (normal-voltage mode, DCCH not connected): VREGH stays disabled. */

&lfxo {
	load-capacitors = "internal";
	load-capacitance-picofarad = <9>;  /* CM7V-T1A, CL 9 pF */
};

/* P0.02/P0.03 (NFC1/NFC2) are spare GPIO pads; native NFC is unused. */
&uicr {
	nfct-pins-as-gpios;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	imu: icm42688@68 {
		compatible = "invensense,icm42688p-i2c";
		reg = <0x68>;
		int-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		accel-pwr-mode = <ICM42688_DT_ACCEL_LN>;
		accel-odr = <ICM42688_DT_ACCEL_ODR_100>;
		accel-fs = <ICM42688_DT_ACCEL_FS_2>;
		gyro-pwr-mode = <ICM42688_DT_GYRO_LN>;
		gyro-odr = <ICM42688_DT_GYRO_ODR_100>;
		gyro-fs = <ICM42688_DT_GYRO_FS_2000>;
	};

	/* BQ25620 charger at 0x6B: project driver to be added. */
};

/* NTAG (NT3H2111) at 0x55 on its own bus: project driver to be added. */
&i2c2 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c2_default>;
	pinctrl-1 = <&i2c2_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Matrix chain; LAT and BLANK are GPIOs driven through GPIOTE, no chip select. */
&spi4 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi4_default>;
	pinctrl-1 = <&spi4_sleep>;
	pinctrl-names = "default", "sleep";
};

&pdm0 {
	status = "okay";
	pinctrl-0 = <&pdm0_default>;
	pinctrl-1 = <&pdm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* VBAT: switched 47k/47k divider, 4.2 V -> 2.1 V; gain 1/4 x 0.6 V = 2.4 V full scale. */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};

	/* CC1/CC2: ratio 0.107 behind the pass gate; gain 2 x 0.6 V = 0.3 V full scale. */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
	};

	/* VLED: 200k/4.7k (0.023); gain 4 x 0.6 V = 0.15 V full scale. */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};
};

&wdt0 {
	status = "okay";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";
};

/* Default memory partitions (no external flash on Rev A; QSPI pins are spare). */
#include <nordic/nrf5340_cpuapp_partition.dtsi>
