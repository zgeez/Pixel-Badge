config REVA_MATRIX
	bool "Rev A TLC59283 / HC595 SPI matrix"
	default y
	depends on DT_HAS_SMARTLEDBADGE_REVA_MATRIX_ENABLED && DISPLAY && SOC_NRF52840
	select GPIO
	select SPI
	select NRFX_GPPI
	help
	  Hardware-driven scan: rows of each brightness plane run from TIMER
	  compares, PPI and SPIM2 EasyDMA without the CPU, and one interrupt
	  per plane sets the next on-time. The slot timer stops in hardware
	  after every plane, so a stalled CPU leaves LAT idle and the external
	  one-shot blanks the matrix. SPIM3 stays with Zephyr's SPI driver for
	  the diagnostics chain readback, before the scan owns the pins.

config REVA_MATRIX_THREAD_PRIORITY
	int "Matrix worker thread priority"
	default 12
	depends on REVA_MATRIX
	help
	  The worker powers the LED rail, starts the scan and supervises plane
	  progress (a scan fault after 500 ms without one); it wakes every
	  100 ms while scanning and never shifts rows itself.

config REVA_MATRIX_OUTPUT
	bool "Allow Rev A LED rail and scanning before board acceptance"
	depends on REVA_MATRIX
	default n
	help
	  Off in the initial bring-up image: LED_EN/ARM remain low and BLANK high.
	  Enable only for current-limited matrix bench bring-up. This is not a
	  substitute for charger, battery, rail and scan-stall acceptance.

config REVA_MATRIX_STALL_TEST
	bool "Scan-stall test for the matrix bench"
	depends on REVA_MATRIX_OUTPUT
	help
	  Adds badge_display_stall_test(): one LED is lit after a single LAT
	  pulse with no further pulses, so the external one-shot must blank it.
	  The driver times MTX_SAFE_SENSE and a timer compare re-blanks through
	  PPI at a hard limit. Matrix bench only.

config REVA_MATRIX_POWER_CAP
	bool "Hold the LED rail off until the power policy sets a ceiling"
	depends on REVA_MATRIX
	help
	  The brightness ceiling starts at 0 (LED rail off) instead of 255 and
	  is raised only by badge_display_set_power_cap() from the battery
	  load-shedding policy.
