# EditorConfig: https://editorconfig.org/
# C/C++ settings follow Zephyr conventions.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp}]
indent_style = tab
indent_size = 8
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = tab
indent_size = 8

[{Kconfig,Kconfig.*,*.conf,*.overlay,*.dts,*.dtsi}]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab
indent_size = 8

[*.sh]
indent_style = tab
indent_size = 8

[*.py]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{kicad_sch,kicad_pcb,kicad_pro,kicad_sym,kicad_mod}]
# Generated by KiCad; do not reformat.
indent_style = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
