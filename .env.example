# Personal badge configuration.
#
# Copy to `.env` and fill in real values locally. `.env` is ignored by Git.
# Only placeholder values belong in this file.

# V1-M supports at most 20 alphanumeric characters (14 in byte mode).
# The build uppercases only the scheme; keep short paths in their correct case.
BADGE_URL_LINKEDIN=http://EXAMPLE.COM/L
BADGE_URL_GITHUB=http://EXAMPLE.COM/G
BADGE_URL_PORTFOLIO=https://EXAMPLE.COM
BADGE_URL_RESUME=http://EXAMPLE.COM/R
